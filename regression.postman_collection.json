  "item": [
    {
      "name": "F1 - Register an order and calculate its reward points",
      "item": [
        {
          "name": "Valid complete order → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderReference\":\"{{runPrefix}}01\",\"customerName\":\"Test Customer\",\"storeCode\":\"20000002\",\"loyaltySeason\":\"2026-2027\",\"loyaltyMember\":true,\"pickupMethod\":\"STORE_PICKUP\",\"orderTotal\":210.00,\"petCount\":3,\"adoptedPet\":false,\"subscription\":false}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New 6-digit prefix on every run so references never clash with a previous run",
                  "pm.collectionVariables.set(\"runPrefix\", String(Math.floor(100000 + Math.random() * 900000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"OrderResponse structure\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.all.keys(\"id\", \"orderReference\", \"customerName\", \"storeCode\", \"loyaltySeason\", \"amountPerPet\", \"rewardPoints\", \"breakdown\", \"createdAt\");",
                  "    pm.expect(body.breakdown).to.have.all.keys(\"loyalty\", \"pickup\", \"basket\", \"adoption\", \"subscription\");",
                  "    pm.collectionVariables.set(\"happyReference\", body.orderReference);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
